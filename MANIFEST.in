include LICENSE
include README.md
include pyproject.toml
include package.json
include install.json
include tsconfig.json
include *.js

graft jupyterlab_custom_theme/labextension
graft style
graft src

prune .github
prune binder
prune node_modules
prune lib

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .git*
global-exclude .ipynb_checkpoints