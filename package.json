{
  "name": "jupyterlab-custom-theme",
  "version": "2.1.0",
  "description": "Colourful light theme for JupyterLab with vivid Python linting",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlab-theme"
  ],
  "homepage": "https://github.com/AlexBella365/jupyterlab_theme",
  "bugs": {
    "url": "https://github.com/AlexBella365/jupyterlab_theme/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "AlexBella365",
    "email": ""
  },
  "files": [
    "src/**/*.{js,js.map}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "style/index.js"
  ],
  "main": "src/index.js",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexBella365/jupyterlab_theme.git"
  },
  "scripts": {
    "build": "jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "clean": "jlpm clean:labextension",
    "clean:labextension": "rimraf jupyterlab_custom_theme/labextension",
    "clean:all": "jlpm clean:labextension",
    "eslint": "eslint . --cache --fix",
    "eslint:check": "eslint . --cache",
    "install:extension": "jlpm build",
    "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
    "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
    "prettier": "jlpm prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "jlpm prettier:base --check",
    "stylelint": "jlpm stylelint:check --fix",
    "stylelint:check": "stylelint --cache \"style/**/*.css\""
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.0",
    "@jupyterlab/apputils": "^4.5.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "stylelint": "^15.10.0",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-csstree-validator": "^3.0.0",
    "stylelint-prettier": "^4.0.0"
  },
  "overrides": {
    "sanitize-html": "^2.17.4",
    "postcss": "^8.5.10"
  },
  "resolutions": {
    "sanitize-html": "^2.17.4",
    "postcss": "^8.5.10"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "themePath": "style/index.css",
    "outputDir": "jupyterlab_custom_theme/labextension"
  }
}
